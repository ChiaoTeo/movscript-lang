{
  "name": "@movscript/runtime",
  "version": "0.1.0",
  "description": "MovScript controlled runtime facade for generation providers, jobs, attempts, and candidate outputs.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChiaoTeo/movscript-lang.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/ChiaoTeo/movscript-lang#readme",
  "bugs": {
    "url": "https://github.com/ChiaoTeo/movscript-lang/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "import": "./dist/generation/index.js",
      "require": "./dist/generation/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build"
  },
  "dependencies": {
    "@movscript/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
