{
  "name": "movscript-lang",
  "version": "0.1.1",
  "private": false,
  "packageManager": "pnpm@10.32.1",
  "description": "MovScript AI film production language, compiler, and workspace artifacts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChiaoTeo/movscript-lang.git"
  },
  "homepage": "https://github.com/ChiaoTeo/movscript-lang#readme",
  "bugs": {
    "url": "https://github.com/ChiaoTeo/movscript-lang/issues"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "pack:dry-run": "pnpm -r --filter \"./packages/*\" --if-present build && pnpm -r --filter \"./packages/*\" pack --dry-run",
    "publish:packages": "pnpm -r --filter \"./packages/*\" publish --access public",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}